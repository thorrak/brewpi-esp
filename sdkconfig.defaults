# CONFIG_WS2812_LED_ENABLE is not set

# CONFIG_BT_BLUEDROID_ENABLED is not set

CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM=n
CONFIG_ESP_HTTPS_SERVER_ENABLE=n

# Needed for now to hit iram targets, but should be re-evaluated in the future
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_NIMBLE_SVC_GAP_DEVICE_NAME="BrewPiESP-Config"

CONFIG_FREERTOS_HZ=1000
CONFIG_RMT_TX_ISR_CACHE_SAFE=y
CONFIG_RMT_RX_ISR_CACHE_SAFE=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_XTAL_FREQ_AUTO=y

# Main task runs setup() which initializes WiFi manager, mDNS, LittleFS, BLE, display, etc.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# FreeRTOS Timer task needs more stack for WiFi manager and logging callbacks
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
# The host stack needs to be larger to support certain WiFi Manager operations
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
# esp_wifi_config posts its events on the default event loop, so our handlers
# (display updates, LittleFS writes, HTTP route registration) run on the system
# event task. The 2304-byte default is too tight for that.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# ESP-IDF 5.5.3 NimBLE host flow-control regression (IDFGH-17350) drops the BLE
# link during the provisioning WiFi scan on classic ESP32. esp_wifi_config
# refuses to build with this enabled on 5.5.3. Remove once on IDF 5.5.4+.
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_LOG_LEVEL=2

# ESP WiFi Config component settings
# Reducing max networks (we don't use alternate networks), enabling the SoftAP
# captive portal with our custom Web UI (served from LittleFS), and enabling
# ESP-IDF Network Provisioning over BLE.
CONFIG_WIFI_CFG_MAX_NETWORKS=2
# CONFIG_WIFI_CFG_ENABLE_CLI is not set
CONFIG_WIFI_CFG_ENABLE_SOFTAP=y
CONFIG_WIFI_CFG_ENABLE_WEBUI=y
# esp_wifi_config 0.4.0 made the Web UI source an explicit Kconfig choice; a
# custom path alone no longer selects the filesystem. Under PlatformIO the
# component CMake never runs, so omitting this silently serves the library's
# embedded UI instead of our branded one.
CONFIG_WIFI_CFG_WEBUI_SOURCE_FILESYSTEM=y
CONFIG_WIFI_CFG_WEBUI_CUSTOM_PATH="/littlefs/wifiui"
CONFIG_WIFI_CFG_ENABLE_NETWORK_PROVISIONING=y
CONFIG_WIFI_CFG_NETWORK_PROVISIONING_BLE=y
